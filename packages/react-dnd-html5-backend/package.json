{
  "name": "react-dnd-html5-backend",
  "version": "2.5.6",
  "description": "HTML5 backend for React DnD",
  "main": "lib/index.js",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-dnd/react-dnd.git"
  },
  "scripts": {
    "clean": "../../node_modules/.bin/rimraf lib",
    "build:lib": "./node_modules/.bin/babel src --out-dir lib --no-babelrc --config-file ./babel.build.config.json",
    "build:umd": "../../node_modules/.bin/webpack",
    "build": "../../node_modules/.bin/npm-run-all --parallel build:*",
    "test": "../../node_modules/.bin/npm-run-all clean build",
    "prepublish": "npm test"
  },
  "devDependencies": {
    "react-dnd": "^2.5.4",
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
