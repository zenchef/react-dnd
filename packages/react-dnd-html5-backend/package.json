{
  "name": "@zenchef/react-dnd-html5-backend",
  "version": "2.5.6",
  "description": "HTML5 backend for React DnD",
  "main": "lib/index.js",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenchef/react-dnd.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "../../node_modules/.bin/rimraf lib",
    "build:lib": "./node_modules/.bin/babel src --out-dir lib --no-babelrc --config-file ./babel.build.config.json",
    "build": "../../node_modules/.bin/npm-run-all --parallel build:*",
    "test": "./node_modules/.bin/jest",
    "prepublishOnly": "../../node_modules/.bin/npm-run-all clean build test"
  },
  "devDependencies": {
    "react-dnd": "^2.5.4",
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": ["babel-jest", { "configFile": "./babel.build.config.json", "babelrc": false }]
    }
  }
}
