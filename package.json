{
  "name": "react-dnd-master",
  "private": true,
  "description": "React-DnD Monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-dnd/react-dnd.git"
  },
  "keywords": [
    "react",
    "reactjs",
    "file",
    "drag",
    "drop",
    "html5",
    "draggable",
    "droppable",
    "drag-and-drop",
    "dnd",
    "javascript",
    "react-component",
    "hoc"
  ],
  "author": "Dan Abramov <dan.abramov@me.com> (http://github.com/gaearon)",
  "contributors": [
    "Chris Trevino <darthtrevino@gmail.com> (http://github.com/darthtrevino)",
    "Jordan Gensler (http://github.com/kesne)",
    "Gagan (https://github.com/thetechie)"
  ],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/react-dnd/react-dnd/issues"
  },
  "homepage": "https://github.com/react-dnd/react-dnd",
  "scripts": {
    "start": "./scripts/startSiteDevServer.sh",
    "build-site": "./scripts/buildStaticSite.sh",
    "publish-site": "./scripts/publishStaticSite.sh",
    "postinstall": "lerna bootstrap",
    "unit_test": "jest",
    "jest:watch": "jest --watch",
    "jest:cov": "jest --coverage",
    "lint": "eslint .",
    "test_modules": "lerna run test --stream",
    "test": "npm-run-all lint jest:cov test_modules",
    "prettier": "prettier 'packages/*/**/*.js' 'examples/**/*.js' 'site/**/*.js' --write",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "autoprefixer": "^7.1.2",
    "babel-cli": "^6.24.1",
    "babel-eslint": "^7.2.3",
    "babel-loader": "^7.1.1",
    "babel-plugin-transform-decorators-legacy": "^1.3.4",
    "babel-preset-env": "^1.6.0",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-2": "^6.24.1",
    "babel-register": "^6.24.1",
    "css-loader": "^0.28.4",
    "eslint": "^3.14.0",
    "eslint-config-airbnb": "^14.0.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-jsx-a11y": "^3.0.2",
    "eslint-plugin-react": "^6.9.0",
    "extract-text-webpack-plugin": "^2.0.0",
    "faker": "^3.1.0",
    "file-loader": "^0.11.2",
    "html-loader": "^0.4.5",
    "husky": "^0.14.3",
    "immutability-helper": "^2.4.0",
    "jest": "^20.0.4",
    "karma-sourcemap-loader": "^0.3.6",
    "lerna": "^2.0.0",
    "less": "^2.7.2",
    "less-loader": "^4.0.5",
    "lint-staged": "^4.2.3",
    "marked": "^0.3.6",
    "npm-run-all": "^4.0.2",
    "null-loader": "^0.1.0",
    "postcss": "^6.0.6",
    "prettier": "^1.7.4",
    "prop-types": "^15.6.0",
    "react": "^16.x",
    "react-dom": "^16.x",
    "react-frame-component": "^1.1.0",
    "react-hot-loader": "3.0.0-beta.7",
    "rimraf": "^2.6.1",
    "style-loader": "^0.18.2",
    "url-loader": "^0.5.9",
    "webpack": "^3.1.0",
    "webpack-dev-server": "^2.5.1"
  },
  "resolutions": {
    "**/cipher-base": "1.0.5",
    "**/cryptiles": "3.1.3",
    "**/deep-extend": "0.5.1",
    "**/elliptic": "6.6.1",
    "**/eventsource": "1.1.1",
    "**/form-data": "2.5.4",
    "**/fsevents": "1.2.11",
    "**/handlebars": "4.7.9",
    "**/json-schema": "0.4.0",
    "**/loader-utils": "1.4.1",
    "**/lodash": "4.17.21",
    "**/macaddress": "0.2.9",
    "**/minimist": "1.2.6",
    "**/pbkdf2": "3.1.3",
    "**/sha.js": "2.4.12",
    "**/shell-quote": "1.8.4",
    "**/url-parse": "1.5.8",
    "**/websocket-driver": "0.7.5"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-dnd$": "<rootDir>/packages/react-dnd/src",
      "react-dnd-html5-backend": "<rootDir>//packages/react-dnd-html5-backend/src",
      "dnd-core": "<rootDir>//packages/dnd-core/src"
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "useTabs": true
  }
}
